modules = ["python-3.12", "nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cargo", "glibcLocales", "libiconv", "libxcrypt", "ocl-icd", "opencl-headers", "openssl", "pkg-config", "rustc", "xsimd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sankofa Enterprise"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Sankofa Enterprise"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sankofa-enterprise-real/frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sankofa-enterprise-real/backend && python api/production_api.py"
waitForPort = 8000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 38265
externalPort = 3000

[[ports]]
localPort = 46495
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "(cd sankofa-enterprise-real/backend && python api/production_api.py) & (cd sankofa-enterprise-real/frontend && npx vite preview --host 0.0.0.0 --port 5000)"]
build = ["bash", "-c", "cd sankofa-enterprise-real/frontend && npm run build"]

[userenv]

[userenv.development]
