# ============================================================================
# SANKOFA ENTERPRISE PRO - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and update values for your environment
# NEVER commit .env to version control
#
# VULNERABILITIES FIXED:
# V001: Security DB migrado para PostgreSQL (usar DATABASE_URL)
# V002: DSR LGPD real implementado
# V003: Cache usa JSON em vez de pickle
# V004: CSP sem unsafe-inline em produção
# V005: Rate limiting distribuído com Redis
# V006: Encryption key persistida
# ============================================================================

# ----------------------------------------------------------------------------
# Environment (CRITICAL - affects security settings)
# ----------------------------------------------------------------------------
ENVIRONMENT=development
# Em produção, definir como: ENVIRONMENT=production

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
POSTGRES_DB=sankofa_fraud_db
POSTGRES_USER=sankofa_admin
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_HOST=postgres
DB_PORT=5432
DB_POOL_MIN=10
DB_POOL_MAX=100

# V001 FIX: DATABASE_URL para PostgreSQL (usado pelo security system)
DATABASE_URL=postgresql://sankofa_admin:CHANGE_ME_IN_PRODUCTION@postgres:5432/sankofa_fraud_db

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
REDIS_MAX_MEMORY=512mb

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_STRING

# ----------------------------------------------------------------------------
# Security Configuration (V001, V006 FIX)
# ----------------------------------------------------------------------------
# V001/V006 FIX: JWT Secret - OBRIGATÓRIO em produção
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_STRING
SANKOFA_JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_STRING

# V006 FIX: Encryption Key - OBRIGATÓRIO em produção
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_STRING
SANKOFA_ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_STRING

# V006 FIX: Salt para derivação de chave (opcional, mas recomendado)
ENCRYPTION_SALT=sankofa-enterprise-salt-CHANGE-ME

# CORS
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# V005 FIX: Rate limiting (usa Redis automaticamente em produção)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per minute

# ----------------------------------------------------------------------------
# AWS Configuration (Production Only)
# ----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=sankofa-models
AWS_SECRETS_MANAGER_ENABLED=false

# ----------------------------------------------------------------------------
# Observability Configuration
# ----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
SENTRY_DSN=
DATADOG_API_KEY=

# ----------------------------------------------------------------------------
# ML Configuration
# ----------------------------------------------------------------------------
ML_MODEL_PATH=/app/models
FEATURE_STORE_ENABLED=true
ML_CACHE_TTL=3600

# ----------------------------------------------------------------------------
# Grafana Configuration
# ----------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ----------------------------------------------------------------------------
# Build Configuration
# ----------------------------------------------------------------------------
BUILD_DATE=2025-12-12
VERSION=1.0.1
VCS_REF=main

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
#
# 1. ENVIRONMENT=production
# 2. DATABASE_URL points to PostgreSQL
# 3. JWT_SECRET is a strong random string (64+ chars)
# 4. ENCRYPTION_KEY is a strong random string (32+ chars)
# 5. All CHANGE_ME values are replaced
# 6. REDIS_PASSWORD is set
# 7. POSTGRES_PASSWORD is set
# 8. DEBUG=0
# ============================================================================
